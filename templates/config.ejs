<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuration Management</title>
    <link rel="stylesheet" href="/css/config.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>
    <div class="container">
        <!-- Filter Section -->
        <div class="filter-section">
            <div class="logout-container">
                <a href="#" id="logoutBtn" class="logout-link">Logout</a>
            </div>
            <h2>Configuration Management</h2>
            <form id="filterForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="operation">Select Operation:</label>
                        <select id="operation" name="operation" required>
                            <option value="">--Select Operation--</option>
                        </select>
                    </div>

                    <!-- PMCd Filter (hidden by default, shown for Design Size) -->
                    <div class="form-group hidden" id="pmcdFilterGroup">
                        <label for="pmcdSelect"> Category (PMCd):</label>
                        <select id="pmcdSelect" onchange="handlePMCdChange()">
                            <option value="">--Select Category--</option>
                        </select>
                    </div>

                    <!-- New PMCd Input (hidden by default) -->
                    <div class="form-group hidden" id="newPMCdGroup">
                        <label for="newPMCdInput">New Category Name:</label>
                        <input type="text" id="newPMCdInput" placeholder="Enter new category" maxlength="30">
                    </div>

                    <div class="form-group submit-group">
                        <label>&nbsp;</label>
                        <button type="submit" id="submitBtn">Submit</button>
                    </div>
                </div>
            </form>
        </div>

        <div id="messageContainer"></div>

        <!-- Results Section -->
        <div id="resultsSection" class="results-section hidden">
            <div class="section-header">
                <h3 id="dataTitle">Records</h3>
                <div class="button-group">
                    <button type="button" id="addBtn" class="btn-primary hidden">Add Data</button>
                    <button type="button" id="saveAllBtn" class="btn-success hidden"
                        onclick="ConfigManager.handleSaveAll()">Save All</button>
                </div>
            </div>
            <div class="table-container">
                <table id="resultsTable">
                    <thead id="tableHeader">
                    </thead>
                    <tbody id="tableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay hidden">
        <div class="spinner"></div>
    </div>

    <!-- Confirmation Dialog -->
    <div id="confirmDialog" class="confirm-dialog hidden">
        <div class="confirm-content">
            <h3>Confirm Delete</h3>
            <p id="confirmMessage">Are you sure you want to delete this record?</p>
            <div class="confirm-buttons">
                <button id="confirmDeleteBtn" class="confirm-btn">Delete</button>
                <button id="cancelDeleteBtn" class="cancel-btn">Cancel</button>
            </div>
        </div>
    </div>

    <script src="/js/operations/custMstHandler.js"></script>
    <script src="/js/operations/emailHandler.js"></script>
    <script src="/js/operations/usrMapHandler.js"></script>
    <script src="/js/operations/designSizeHandler.js"></script>
    <script src="/js/operations/csGrdHandler.js"></script>
    <script src="/js/operations/custMpHandler.js"></script>
    <script src="/js/operations/diaGrdHandler.js"></script>
    <script src="/js/operations/roleHandler.js"></script>
    <script src="/js/operations/slsPrsnHandler.js"></script>
    <script src="/js/operations/metCdHandler.js"></script>
    <script src="/js/operations/metColHandler.js"></script>
    <script src="/js/operations/metKtHandler.js"></script>
    <script src="/js/operations/ctgFilterHandler.js"></script>
    <script src="/js/operations/rgFilterHandler.js"></script>
    <script src="/js/operations/advEventHandler.js"></script>
    <script src="/js/operations/PosCTAHandler.js"></script>
    <script src="/js/operations/usersHandler.js"></script>
    <script src="/js/config.js"></script>
</body>

</html>